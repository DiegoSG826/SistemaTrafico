          "green_eo": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 20.0,
            "title": "Green Eo"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 5,
            "title": "Reason"
          },
          "duration_cycles": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
