            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "lanes": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Lanes",
            "default": 1
          },
          "discharge_vps": {
            "type": "number",
            "maximum": 2.0,
            "exclusiveMinimum": 0.0,
            "title": "Discharge Vps",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "latitude",
          "longitude"
        ],
        "title": "IntersectionInput"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
